{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SFHQ-VirtualID Dataset Schemas",
  "description": "Schemas for the SFHQ-VirtualID releases: Bench (224x224 aligned crops, balanced + imbalanced) and Raw (1024x1024 portraits, max-size).",
  "type": "object",
  "definitions": {
    "bench_balanced": {
      "type": "object",
      "description": "dataset.csv / dataset.parquet — SFHQ-VirtualID-Bench balanced (224x224 crops, MUFAC-aligned splits, BOTH forget schedules)",
      "properties": {
        "image_path": {
          "type": "string",
          "description": "Release-relative path to the 224x224 face crop, e.g. images/identity_037/crop_012.jpg",
          "pattern": "^(processed/)?images/identity_\\d{3}/crop_\\d{3}\\.jpg$"
        },
        "identity_id": {"type": "integer", "minimum": 0, "maximum": 749},
        "age_group": {"type": "integer", "minimum": 0, "maximum": 3},
        "age": {"type": "integer", "minimum": 0, "maximum": 120},
        "gender": {"type": "integer", "minimum": 0, "maximum": 1},
        "split": {"type": "string", "enum": ["retain", "forget"]},
        "forget_step": {"type": "integer", "minimum": -1, "maximum": 14},
        "forget_step_poisson": {"type": "integer", "minimum": -1, "maximum": 14},
        "image_subset": {"type": "string", "enum": ["train", "holdout"]},
        "arcface_similarity": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "laplacian_variance": {"type": "number", "minimum": 0.0},
        "detection_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0}
      },
      "required": [
        "image_path", "identity_id", "age_group", "age", "gender",
        "split", "forget_step", "forget_step_poisson", "image_subset",
        "arcface_similarity", "laplacian_variance", "detection_confidence"
      ],
      "additionalProperties": false
    },
    "bench_imbalanced": {
      "type": "object",
      "description": "dataset_imbalanced.csv / .parquet — SFHQ-VirtualID-Bench imbalanced (5:1 ratio gradient 82:41:16 train; NO forget-schedule columns — the schedule axis lives in balanced)",
      "properties": {
        "image_path": {
          "type": "string",
          "description": "Release-relative path to the 224x224 face crop, e.g. images/identity_037/crop_012.jpg",
          "pattern": "^(processed/)?images/identity_\\d{3}/crop_\\d{3}\\.jpg$"
        },
        "identity_id": {"type": "integer", "minimum": 0, "maximum": 749},
        "age_group": {"type": "integer", "minimum": 0, "maximum": 3},
        "age": {"type": "integer", "minimum": 0, "maximum": 120},
        "gender": {"type": "integer", "minimum": 0, "maximum": 1},
        "split": {"type": "string", "enum": ["retain", "forget"]},
        "image_subset": {"type": "string", "enum": ["train", "holdout"]},
        "arcface_similarity": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "laplacian_variance": {"type": "number", "minimum": 0.0},
        "detection_confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "popularity_bin": {"type": "string", "enum": ["high", "medium", "low"]},
        "images_per_identity": {"type": "integer", "minimum": 1}
      },
      "required": [
        "image_path", "identity_id", "age_group", "age", "gender",
        "split", "image_subset",
        "arcface_similarity", "laplacian_variance", "detection_confidence",
        "popularity_bin", "images_per_identity"
      ],
      "additionalProperties": false
    },
    "raw": {
      "type": "object",
      "description": "dataset_raw.csv / .parquet — SFHQ-VirtualID-Raw (1024x1024 max-size portraits, no splits)",
      "properties": {
        "image_path": {
          "type": "string",
          "description": "Release-relative path to the 1024x1024 portrait, e.g. images/identity_037/portrait_012.png",
          "pattern": "^images/identity_\\d{3}/portrait_\\d{3}\\.png$"
        },
        "identity_id": {"type": "integer", "minimum": 0, "maximum": 749},
        "age_group": {"type": "integer", "minimum": 0, "maximum": 3},
        "age": {"type": "integer", "minimum": 0, "maximum": 120},
        "gender": {"type": "integer", "minimum": 0, "maximum": 1},
        "arcface_similarity": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "pose": {"type": "string"},
        "expression": {"type": "string"},
        "lighting": {"type": "string"},
        "setting": {"type": "string"},
        "camera": {"type": "string"}
      },
      "required": [
        "image_path", "identity_id", "age_group", "age", "gender",
        "arcface_similarity", "pose", "expression", "lighting",
        "setting", "camera"
      ],
      "additionalProperties": false
    }
  }
}
