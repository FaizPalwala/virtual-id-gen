{
  "family": "SFHQ-VirtualID",
  "version": "1.0.0",
  "release_date": "PENDING — dissertation submission; uploads gated/private until then",
  "releases": {
    "bench": {
      "name": "SFHQ-VirtualID-Bench",
      "resolution": [224, 224],
      "color_mode": "BGR",
      "format": "JPEG",
      "artifacts": {
        "dataset.csv/.parquet": {
          "description": "Balanced aligned crops (MUFAC-aligned splits)",
          "images": 67500,
          "images_per_identity": 90,
          "train_per_identity": 72,
          "holdout_per_identity": 18
        },
        "dataset_imbalanced.csv/.parquet": {
          "description": "Ratio-based gradient crops, 5:1 (82:41:16 train)",
          "images": 36064,
          "train_gradient_ratio": {"high": 1.0, "medium": 0.50, "low": 0.20},
          "train_per_bin": {"high": 82, "medium": 41, "low": 16},
          "holdout_per_identity": 18,
          "kept_per_bin": {"high": 100, "medium": 59, "low": 34},
          "exclusions": "11 high-bin rows absent vs 75x100 target: 123 candidates failed the preprocess quality gate (blur/unreadable), capping 10 high-bin identity pools at 98-99"
        }
      }
    },
    "raw": {
      "name": "SFHQ-VirtualID-Raw",
      "resolution": [1024, 1024],
      "color_mode": "RGB",
      "format": "JPEG q95 (4:4:4; re-encoded from PNG at release time)",
      "artifacts": {
        "dataset_raw.csv/.parquet": {
          "description": "Max-size full-res portraits (no splits, no quality trim)",
          "images": 75000,
          "images_per_identity": 100,
          "exclusions": "none (all 75,000 generated candidates shipped)"
        }
      }
    }
  },
  "identity_count": 750,
  "splits": {
    "retain": {"identities": 675},
    "forget": {"identities": 75, "steps": 15, "per_step": 5,
               "schedules": {
                   "uniform": "forget_step column (baseline; step index == cumulative count)",
                   "poisson": "forget_step_poisson column (seeded, lambda=5, rebalanced to 75; evaluate by cumulative count — Ginart et al. 2019, arXiv:2012.01668, arXiv:2507.15280)"
               }},
    "image_subset": {"train": "per-identity train images", "holdout": "per-identity held-out evaluation images"}
  },
  "shared_invariant": "Every identity_id maps to exactly one split (retain|forget) and contributes BOTH image_subset values (train|holdout) in the Bench releases. Raw has no splits.",
  "random_seed": 42,
  "shard_seeds": [42, 44, 46, 48, 50, 52, 54, 56, 58, 60, 62, 64, 66, 68, 70],
  "shard_count": 15,
  "identities_per_shard": 50,
  "git_commit": "e397d3b",
  "generation_config": {
    "base_model": "RunDiffusion/Juggernaut-XL-v9",
    "num_inference_steps": 30,
    "guidance_scale": 3.0,
    "ip_adapter_scale": 0.85,
    "controlnet_conditioning_scale": 0.80,
    "generation_resolution": [1024, 1024],
    "crop_resolution": [224, 224],
    "candidates_per_identity": 100,
    "images_per_identity_balanced": 90,
    "min_similarity_raw": 0.40,
    "min_similarity_final": 0.45,
    "blur_threshold": 80.0,
    "mtcnn_confidence_threshold": 0.85,
    "prompt_pool_size": 100,
    "prompts_per_identity": 100
  },
  "metadata_columns": {
    "bench": [
      "image_path", "identity_id", "age_group", "age", "gender", "split",
      "forget_step", "forget_step_poisson", "image_subset", "arcface_similarity",
      "laplacian_variance", "detection_confidence"
    ],
    "bench_imbalanced": [
      "image_path", "identity_id", "age_group", "age", "gender", "split",
      "image_subset", "arcface_similarity", "laplacian_variance",
      "detection_confidence", "popularity_bin", "images_per_identity"
    ],
    "raw": [
      "image_path", "identity_id", "age_group", "age", "gender",
      "arcface_similarity", "pose", "expression", "lighting",
      "setting", "camera"
    ]
  },
  "package_versions": {
    "python": "3.10",
    "torch": "2.6.0+cu124",
    "diffusers": "0.39.0",
    "onnxruntime_gpu": "1.19.2",
    "transformers": "TBD (pip freeze on Aire)",
    "insightface": "TBD (pip freeze on Aire)",
    "facenet_pytorch": "TBD (pip freeze on Aire)",
